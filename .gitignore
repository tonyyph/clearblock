# Intermediate captures for the store screenshots; the composed ones are kept.
docs/screenshots/raw-*.png

# Upstream filter lists are fetched at build time (npm run filters:fetch).
# They are third-party licensed content and are not redistributed from this repo;
# the compiled output in src/rules/ is what ships.
filters/*.txt

# Compiled cosmetic-selector table. Regenerated by `npm run filters:compile`, and
# nothing imports it yet — list-based cosmetic filtering is not wired up. Un-ignore
# it when it is, so a clean clone can build without fetching the lists first.
src/content/generated-cosmetic.json
