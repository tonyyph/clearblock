{
  "name": "clearblock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ClearBlock - a privacy-first ad and tracker blocker for Chrome (Manifest V3)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run clean && npm run build:app && npm run build:content && npm run build:mainworld && npm run build:static",
    "build:app": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:static": "node scripts/build-static.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:rules": "node scripts/validate-rules.mjs",
    "validate": "npm run validate:rules && npm run validate:manifest",
    "zip": "node scripts/package-zip.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run validate",
    "release": "npm run verify && npm run zip",
    "screenshots": "node scripts/make-store-screenshots.mjs",
    "promo": "node scripts/make-promo-tiles.mjs",
    "store:assets": "npm run screenshots && npm run promo",
    "store": "npm run build && npm run zip && npm run store:assets && node scripts/build-store-folder.mjs",
    "filters:fetch": "node scripts/fetch-filters.mjs",
    "filters:compile": "node scripts/compile-filters.mjs",
    "filters": "npm run filters:fetch && npm run filters:compile && npm run validate:rules",
    "build:mainworld": "vite build --config vite.mainworld.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "jsdom": "30.1.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
